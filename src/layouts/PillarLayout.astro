---
/**
 * Layout for the stack pages (Mind, Fuel, Movement) and the Optimization
 * category pages under /the-stacks/. Frontmatter is validated by the `stacks`
 * collection in src/content.config.ts.
 *
 * 2026-11 repositioning: the H1 is the reader-facing `headline` (what you
 * get), the page name moves to the label, and every page ends on the same
 * next step — Build Your Stack, or the free guide.
 */
import BaseLayout from './BaseLayout.astro';
import NextStep from '../components/NextStep.astro';
import { SITE } from '../config/site';

interface Props {
  frontmatter: {
    title: string;
    headline?: string;
    description: string;
    pillar: 'movement' | 'fuel' | 'optimization' | 'mind';
    eyebrow?: string;
    order?: number;
  };
}
const { frontmatter } = Astro.props;
// Optimization category pages (Peptide Protocols, Labs, …) vs. a top-level stack page.
const isCategory = frontmatter.eyebrow === 'Optimization';
const label = isCategory ? `Optimization · ${frontmatter.title}` : `${frontmatter.title} stack`;
const pennant = `/brand/stack-banner-${frontmatter.pillar}.svg`;
---
<BaseLayout title={`${frontmatter.title} — ${SITE.name}`} description={frontmatter.description}>
  <section class="pillar-hero on-dark">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/the-stacks/">The Stacks</a>
        {isCategory && (
          <><span aria-hidden="true">·</span><a href="/the-stacks/optimization/">Optimization</a></>
        )}
      </nav>
      <div class="hero-row">
        <div>
          <div class="label">{label}</div>
          <h1>{frontmatter.headline ?? frontmatter.title}</h1>
          <p class="lede">{frontmatter.description}</p>
        </div>
        {!isCategory && (
          <img
            class="pennant"
            src={pennant}
            alt=""
            width="360"
            height="480"
            loading="eager"
          />
        )}
      </div>
    </div>
  </section>
  <section>
    <div class="wrap prose">
      <slot />
    </div>
  </section>
  <NextStep />
</BaseLayout>

<style>
  .pillar-hero{padding:clamp(56px,8vw,90px) 0}
  .crumbs{margin-bottom:26px;font-family:var(--mono);font-size:var(--fs-label);letter-spacing:0.08em}
  .crumbs a{color:var(--stone-light);text-decoration:none;text-transform:uppercase}
  .crumbs a:hover{color:var(--amber)}
  .crumbs span{margin:0 10px;color:var(--stone-light)}
  h1{margin:14px 0 18px;max-width:16em}
  .lede{max-width:var(--measure);font-size:var(--fs-body-lg);color:var(--stone-light)}
  .hero-row{display:flex;gap:clamp(24px,5vw,64px);align-items:center;justify-content:space-between}
  .pennant{width:clamp(90px,12vw,140px);height:auto;flex-shrink:0}
  @media(max-width:640px){.pennant{display:none}}
</style>
