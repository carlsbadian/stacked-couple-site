---
/**
 * Homepage — Direction A, "Proof-led" (2026-11 repositioning).
 * Reader-first: what they're feeling → what they get → how it works → proof →
 * who's behind it → the guide. Todd & Jenn's story lives on /about/; here it
 * is a short credibility note, not the lead.
 *
 * Numbers and before/after photos come from src/config/proof.ts. Anything
 * not yet filled renders as a visible [PLACEHOLDER] — fill before merging.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { SITE, GUIDE } from '../config/site';
import { STACKS } from '../config/stacks';
import { METRICS, PHOTOS } from '../config/proof';

/* ---- sparklines: real data when a metric has a series, a labeled generic shape otherwise ---- */
const W = 110, H = 34, P = 3;
const ILLUSTRATIVE = [
  [30, 27, 28, 22, 19, 14, 9, 5],
  [26, 28, 22, 24, 17, 15, 11, 9],
  [29, 25, 25, 20, 16, 16, 10, 6],
  [24, 26, 19, 21, 15, 12, 13, 8],
];
const x = (i: number, n: number) => (P + (i * (W - 2 * P)) / (n - 1)).toFixed(1);
const fromYs = (ys: number[]) => ys.map((y, i) => `${x(i, ys.length)},${y}`).join(' ');
const fromSeries = (s: number[]) => {
  const min = Math.min(...s), span = Math.max(...s) - min || 1;
  return s.map((v, i) => `${x(i, s.length)},${(H - P - ((v - min) / span) * (H - 2 * P)).toFixed(1)}`).join(' ');
};
const SPARK = ['var(--steel)', 'var(--copper)', 'var(--amber)', 'var(--navy)'];

const metrics = METRICS.map((m, i) => {
  const real = !!(m.series && m.series.length > 1);
  return {
    label: m.label,
    real,
    points: real ? fromSeries(m.series!) : fromYs(ILLUSTRATIVE[i % ILLUSTRATIVE.length]),
    color: SPARK[i % SPARK.length],
    value: `${m.start ?? '[START]'} → ${m.now ?? '[NOW]'}`,
    detail: m.detail ?? '[METRIC] over [TIMEFRAME]',
    filled: !!(m.start && m.now),
  };
});
const anyIllustrative = metrics.some((m) => !m.real);

const pains = [
  'Energy that’s gone by mid-afternoon',
  'Strength and muscle that are harder to keep',
  'Sleep that doesn’t leave you rested',
  'Stress and brain fog that won’t lift',
  'Endless advice, and no clear plan',
];

const steps = [
  { title: 'Get the free guide', body: 'The starting point we wish we’d had: what to know before day one.', free: true },
  { title: 'Build your stack', body: 'A short assessment: your goals, your history, and where you’re starting from.', free: true },
  { title: 'Your Stack Session', body: 'A 15-minute call with us to talk through your answers and what to prioritize first.', free: false },
  { title: 'Your Phase 1 Stack Plan', body: 'What to start, what to track, and when to adjust — written for you.', free: false },
];

const photos = [
  { key: 'before', label: 'Before photo', ...PHOTOS.before },
  { key: 'after', label: 'After photo', ...PHOTOS.after },
];
---
<BaseLayout
  title={`${SITE.name} — Get stronger, sleep deeper, and feel like yourself again`}
  description="Practical plans across four stacks — optimization, mind, fuel, and movement — built from what we test and track on ourselves first. Start with the free guide."
>
  <!-- HERO -->
  <section class="hero on-dark">
    <div class="wrap wrap-wide hero-grid">
      <div class="hero-copy">
        <p class="kicker">Strength · Energy · Sleep · Focus</p>
        <h1>Get stronger, sleep deeper, and feel like yourself again.</h1>
        <p class="hero-sub">
          Practical plans across four stacks — optimization, mind, fuel, and movement —
          built from what we test and track on ourselves first. Start with the free guide.
        </p>
        <div class="ctas">
          <a class="btn btn-solid" href="/get-the-guide/">Get the Free Guide</a>
          <a class="btn btn-ghost" href="/build-your-stack/">Build Your Stack</a>
        </div>
        <p class="hero-note">Free {GUIDE.pages}-page PDF, sent straight to your inbox.</p>
      </div>

      <div class="track-card">
        <div class="track-head">
          <span class="kicker">Our tracking</span>
          {anyIllustrative && <span class="chip">Illustrative</span>}
        </div>
        <p class="track-title">Tracked, not guessed.</p>
        <ul class="track-rows">
          {metrics.map((m) => (
            <li>
              <span class="m-label">{m.label}</span>
              <svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
                <polyline points={m.points} style={`stroke:${m.color}`} />
              </svg>
              <span class="m-value data">{m.value}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- SOUND FAMILIAR -->
  <section class="pains">
    <div class="wrap wrap-wide">
      <p class="kicker">Sound familiar?</p>
      <h2>If this sounds like you, you’re in the right place.</h2>
      <ul class="pain-grid">
        {pains.map((p) => (
          <li>
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 15 L12 9 L20 15" /></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
      <p class="pain-close">
        You don’t need more information. You need a plan you can follow — and a way
        to see it working.
      </p>
    </div>
  </section>

  <!-- THE FOUR STACKS -->
  <section class="stacks">
    <div class="wrap wrap-wide">
      <p class="kicker">The four stacks</p>
      <h2>Four stacks. One plan, built around you.</h2>
      <p class="section-sub">Every plan draws from the same four areas. You start where you’ll feel it most.</p>
      <div class="stack-grid">
        {STACKS.map((s) => (
          <article class="stack-card" style={`--stack:${s.color}`}>
            <img src={s.icon} alt="" width="64" height="64" loading="lazy" />
            <span class="stack-name">{s.name} stack</span>
            <h3>{s.outcome}</h3>
            <p>{s.summary}</p>
            <a href={s.href}>Explore {s.name} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how on-dark" id="how-it-works">
    <div class="wrap wrap-wide">
      <p class="kicker">How it works</p>
      <h2>Start free. Go further when you’re ready.</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <div class="step-top">
              <span class="step-num">{i + 1}</span>
              {s.free && <span class="tag">Free</span>}
            </div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
      <div class="ctas">
        <a class="btn btn-solid" href="/build-your-stack/">Build Your Stack</a>
        <a class="text-link" href="/get-the-guide/">Or start with the free guide →</a>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="proof">
    <div class="wrap wrap-wide">
      <p class="kicker">The numbers</p>
      <h2>We track it. Then we show you.</h2>
      <p class="section-sub">
        Our own labs, body composition, and timelines — updated as we go. Your results
        will be your own.
      </p>
      <div class="metric-grid">
        {metrics.map((m) => (
          <div class="metric">
            <p class="metric-label">{m.label}</p>
            <p class="metric-value">{m.value}</p>
            <p class="metric-detail">{m.detail}</p>
          </div>
        ))}
      </div>
      <div class="photo-row">
        {photos.map((ph) => (
          <figure>
            {ph.src ? (
              <img src={ph.src} alt={ph.alt ?? ph.label} loading="lazy" />
            ) : (
              <div class="photo-slot" role="img" aria-label={`${ph.label} — coming soon`}>
                <svg width="40" height="40" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
                <span>{ph.label}</span>
              </div>
            )}
            <figcaption>{ph.caption ?? '[NAME] · [DATE]'}</figcaption>
          </figure>
        ))}
      </div>
      <p class="legal">
        Individual results vary. Shared from our own experience for educational purposes —
        not medical advice.
      </p>
    </div>
  </section>

  <!-- WHO'S BEHIND IT -->
  <section class="who">
    <div class="wrap wrap-wide who-grid">
      <img
        class="portrait"
        src="/brand/couple-portrait.webp"
        alt="Illustration of Todd and Jenn"
        width="900"
        height="760"
        loading="lazy"
      />
      <div>
        <p class="kicker">Who’s behind it</p>
        <h2>Two people running the experiment on ourselves.</h2>
        <p class="lead">
          We’re Todd and Jenn. We’re not clinicians — we’re the test subjects. Everything
          we recommend, we’ve researched, run, tracked, and adjusted first.
        </p>
        <p class="lead">
          Then we share what worked, what didn’t, and what we’d do differently — so you
          can skip the guesswork.
        </p>
        <a class="text-link" href="/about/">Read our story →</a>
      </div>
    </div>
  </section>

  <!-- TOOLKIT -->
  <section class="toolkit-strip">
    <div class="wrap wrap-wide strip">
      <p>Everything we use, in one place — with our discount codes.</p>
      <a class="btn btn-ghost" href="/toolkit/">Open the Toolkit</a>
    </div>
  </section>

  <!-- THE GUIDE -->
  <section class="guide on-dark" id="guide">
    <div class="wrap wrap-wide guide-grid">
      <div class="cover-wrap">
        <div class="cover" role="img" aria-label={`Cover of ${GUIDE.name}`}>
          <img src="/brand/chevron.svg" alt="" width="64" height="58" />
          <span class="kicker">Free guide</span>
          <span class="cover-title">{GUIDE.name}</span>
          <span class="cover-by">{SITE.name}</span>
        </div>
      </div>
      <div>
        <p class="kicker">Free guide</p>
        <h2>Start with the guide we wish we’d had.</h2>
        <p class="lead guide-pitch">
          What peptides actually are, how the legal side works, what’s being studied, and
          what to sort out before you spend a dollar.
        </p>
        <p class="guide-facts data">{GUIDE.pages} pages · PDF · Free</p>
        <EmailCapture onDark />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- shared ---------- */
  h2{max-width:18em;margin-bottom:16px}
  .section-sub{font-size:var(--fs-body-lg);color:var(--text-muted);max-width:36em;margin:0 0 44px}
  .on-dark .section-sub{color:var(--stone-light)}
  .ctas{display:flex;flex-wrap:wrap;align-items:center;gap:14px 28px}
  .text-link{font-weight:var(--fw-semibold);font-size:var(--fs-body);padding:12px 0;text-decoration:none}
  .text-link:hover{text-decoration:underline}
  .data{font-family:var(--mono)}

  /* ---------- hero ---------- */
  .hero{
    padding:clamp(56px,8vw,112px) 0;
    background-image:
      linear-gradient(rgba(27,47,74,0.94), rgba(27,47,74,0.94)),
      url('/brand/pattern-dark.webp');
    background-size:auto, 420px auto;
  }
  .hero-grid{display:flex;flex-wrap:wrap;gap:56px;align-items:center}
  .hero-copy{flex:1 1 520px;min-width:0}
  .hero-copy h1{margin:0 0 24px;max-width:15em;line-height:1.08}
  .hero-sub{font-size:var(--fs-body-lg);color:var(--stone-light);max-width:34em;margin:0}
  .hero-copy .ctas{margin-top:36px}
  .hero-note{font-size:var(--fs-caption);color:var(--stone-light);margin:16px 0 0}

  .track-card{
    flex:1 1 380px;max-width:480px;min-width:0;
    background:var(--white);color:var(--ink);
    padding:28px;border-radius:4px;box-shadow:var(--shadow-lift);
  }
  .track-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px}
  .track-head .kicker{color:var(--copper);margin:0}
  .chip{
    font-family:var(--mono);font-size:var(--fs-label);color:var(--stone-deep);
    border:1px solid var(--rule);padding:4px 10px;border-radius:2px;
  }
  .track-title{font-family:var(--serif);font-size:var(--fs-h3);line-height:1.2;color:var(--navy);margin:0 0 18px}
  .track-rows{list-style:none;margin:0;padding:0}
  .track-rows li{
    display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;
    padding:14px 0;border-top:1px solid var(--rule);max-width:none;
  }
  .track-rows li:last-child{border-bottom:1px solid var(--rule)}
  .m-label{flex:1 1 130px;font-weight:var(--fw-medium);color:var(--navy)}
  .track-rows polyline{fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
  .m-value{font-size:var(--fs-label);color:var(--stone-deep)}

  /* ---------- sound familiar ---------- */
  .pains h2{margin-bottom:40px}
  /* flex, not grid: five cards sit in one row on desktop, and when they wrap
     the last one widens to fill its row instead of stranding alone */
  .pain-grid{
    list-style:none;margin:0;padding:0;
    display:flex;flex-wrap:wrap;gap:16px;
  }
  .pain-grid li{
    flex:1 1 200px;
    display:flex;gap:14px;align-items:flex-start;max-width:none;
    background:var(--white);border:1px solid var(--rule);padding:24px;border-radius:4px;
    font-size:var(--fs-body-lg);line-height:1.45;
  }
  .pain-grid svg{flex:0 0 auto;margin-top:2px}
  .pain-grid path{fill:none;stroke:var(--copper);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
  .pain-close{
    font-family:var(--serif);font-size:var(--fs-h3);line-height:1.35;color:var(--navy);
    max-width:30em;margin:48px 0 0;
  }

  /* ---------- four stacks ---------- */
  .stacks{background:var(--white)}
  /* the homepage's three four-item grids (stacks, steps, metrics) go 4 → 2 → 1,
     never 3 + 1 with an orphan on a laptop-width screen */
  .stack-grid,.steps,.metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
  @media (max-width:1100px){ .stack-grid,.steps,.metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))} }
  @media (max-width:600px){ .stack-grid,.steps,.metric-grid{grid-template-columns:minmax(0,1fr)} }
  .stack-grid{gap:20px}
  .stack-card{
    display:flex;flex-direction:column;gap:14px;
    background:var(--cream);border-top:6px solid var(--stack);padding:32px 28px;
  }
  .stack-card img{height:64px;width:auto;align-self:flex-start}
  .stack-name{
    font-family:var(--mono);font-size:var(--fs-label);font-weight:var(--fw-semibold);
    letter-spacing:var(--track-label);text-transform:uppercase;color:var(--navy);
  }
  .stack-card h3{margin:0;line-height:1.2}
  .stack-card p{margin:0;flex:1}
  .stack-card a{font-weight:var(--fw-semibold);padding:10px 0;text-decoration:none}
  .stack-card a:hover{text-decoration:underline}

  /* ---------- how it works ---------- */
  .how h2{margin-bottom:48px}
  .steps{list-style:none;margin:0 0 52px;padding:0;gap:32px 28px}
  .steps li{
    display:flex;flex-direction:column;gap:12px;max-width:none;
    padding-top:24px;border-top:1px solid var(--line-dark);
  }
  .step-top{display:flex;align-items:center;gap:12px}
  .step-num{
    display:inline-flex;align-items:center;justify-content:center;
    width:48px;height:48px;border-radius:50%;
    background:var(--amber);color:var(--navy);font-family:var(--serif);font-size:var(--fs-h4);
  }
  .tag{
    font-family:var(--mono);font-size:var(--fs-label);color:var(--amber);
    border:1px solid var(--amber);padding:3px 8px;border-radius:2px;
  }
  .steps h3{margin:0;font-size:var(--fs-h4)}
  .steps p{margin:0;color:var(--stone-light)}

  /* ---------- proof ---------- */
  .metric-grid{gap:20px}
  .metric{background:var(--white);border:1px solid var(--rule);padding:28px;border-radius:4px}
  .metric-label{
    font-family:var(--mono);font-size:var(--fs-label);font-weight:var(--fw-semibold);
    letter-spacing:var(--track-label);text-transform:uppercase;color:var(--stone-deep);margin:0 0 12px;
  }
  .metric-value{font-family:var(--serif);font-size:var(--fs-h3);line-height:1.2;color:var(--navy);margin:0 0 8px}
  .metric-detail{font-size:var(--fs-caption);color:var(--stone-deep);margin:0}
  .photo-row{display:flex;flex-wrap:wrap;gap:20px;margin-top:20px}
  .photo-row figure{flex:1 1 340px;margin:0;min-width:0}
  .photo-row img{display:block;width:100%;height:440px;object-fit:cover;border-radius:4px}
  .photo-slot{
    height:440px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;
    background:var(--placeholder-bg);border:2px dashed var(--placeholder-line);border-radius:4px;
    color:var(--stone-deep);
    font-family:var(--mono);font-size:var(--fs-label);letter-spacing:var(--track-label);text-transform:uppercase;
  }
  .photo-slot path,.photo-slot circle{fill:none;stroke:var(--stone-deep);stroke-width:1.6;stroke-linejoin:round}
  .photo-row figcaption{margin-top:10px}
  .proof .legal{margin:24px 0 0}

  /* ---------- who ---------- */
  .who{background:var(--white)}
  .who-grid{display:flex;flex-wrap:wrap;gap:56px;align-items:center}
  .portrait{flex:0 1 420px;min-width:0;width:100%;max-width:420px;height:auto;display:block}
  .who-grid > div{flex:1 1 440px;min-width:0}
  .who h2{margin-bottom:24px}
  .who .lead{max-width:34em;margin:0 0 16px}
  .who .text-link{display:inline-block;margin-top:12px}

  /* ---------- toolkit strip ---------- */
  .toolkit-strip{padding:44px 0;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}
  .strip{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px 40px}
  .strip p{
    flex:1 1 420px;margin:0;max-width:none;
    font-family:var(--serif);font-size:var(--fs-h3);line-height:1.3;color:var(--navy);
  }

  /* ---------- guide ---------- */
  .guide{
    background-image:
      linear-gradient(rgba(27,47,74,0.94), rgba(27,47,74,0.94)),
      url('/brand/pattern-dark.webp');
    background-size:auto, 420px auto;
  }
  .guide-grid{display:flex;flex-wrap:wrap;gap:56px;align-items:center}
  .cover-wrap{flex:0 1 320px;min-width:0;display:flex;justify-content:center}
  .cover{
    width:300px;max-width:100%;height:390px;background:var(--cream);
    padding:30px 28px;display:flex;flex-direction:column;gap:16px;
    box-shadow:var(--shadow-lift);transform:rotate(-2deg);
  }
  .cover img{width:64px;height:auto}
  .cover .kicker{color:var(--copper);margin:0}
  .cover-title{font-family:var(--serif);font-size:var(--fs-h3);line-height:1.15;color:var(--navy)}
  .cover-by{margin-top:auto;font-size:var(--fs-label);color:var(--stone-deep)}
  .guide-grid > div:last-child{flex:1 1 480px;min-width:0}
  .guide h2{margin-bottom:20px}
  .guide-pitch{color:var(--stone-light);max-width:34em;margin:0 0 12px}
  .guide-facts{font-size:var(--fs-label);color:var(--stone-light);margin:0 0 24px}
  @media (prefers-reduced-motion: reduce){ .cover{transform:none} }
</style>
