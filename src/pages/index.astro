---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from '../components/EmailCapture.astro';
import AffiliateBadge from '../components/AffiliateBadge.astro';
import { SITE, SOCIAL } from '../config/site';

const pillars = [
  {
    num: '01',
    name: 'Optimization',
    href: '/the-stacks/optimization/',
    blurb: 'Protocols, supplements, technology, and labs. Research-informed and built around real life.',
  },
  {
    num: '02',
    name: 'Movement',
    href: '/the-stacks/movement/',
    blurb: 'Training frameworks. Strength, mobility, and recovery built for real life.',
  },
  {
    num: '03',
    name: 'Fuel',
    href: '/the-stacks/fuel/',
    blurb: 'Nutrition to support the protocols and the training. Whole food frameworks, protein targets, and what changes when you get it right.',
  },
  {
    num: '04',
    name: 'Mind',
    href: '/the-stacks/mind/',
    blurb: 'Sleep, stress, and the mindset that makes everything else possible. The real conversations worth having.',
  },
];
const socials = [SOCIAL.youtube, SOCIAL.instagram, SOCIAL.tiktok].filter((s) => s.url);
---
<BaseLayout>
  <!-- HERO — brand name leads; tagline supports -->
  <section class="hero on-dark">
    <div class="wrap">
      <h1 class="brand-name">{SITE.name}</h1>
      <p class="tagline" aria-label={SITE.tagline}>
        <span>Stacking and Tracking.</span>
        <span>Thriving in Midlife.</span>
      </p>
      <div class="hero-ctas">
        <a class="btn btn-solid" href="/get-the-guide/">Get the Guide →</a>
        <a class="btn btn-ghost" href="/the-stacks/">Explore the Stacks</a>
      </div>
    </div>
  </section>

  <!-- WHO WE ARE -->
  <section>
    <div class="wrap">
      <div class="eyebrow-rule"><span class="label">Who We Are</span></div>
      <div class="whoweare-copy">
        <p>We are Todd and Jenn. A couple who refused to accept the version of midlife everyone told us was inevitable.</p>
        <p>We built our relationship on a shared obsession with feeling our best. Our passion for health and vitality is one of the foundations of our marriage.</p>
        <p>We refuse the belief that the best version of ourselves is behind us. That midlife means less energy, less strength, less vitality.</p>
        <p>That refusal drives everything we do.</p>
        <p>We stack. We track. And we built this together so you don't have to figure it out alone.</p>
      </div>
      <p class="manifesto-subline">{SITE.subline}</p>
    </div>
  </section>

  <!-- BRAND BAND -->
  <section class="brand-band">
    <div class="wrap">
      <img
        class="pennant-strip"
        src="/brand/stacks-horizontal.webp"
        alt="The four stacks: Optimization, Movement, Fuel, Mind."
        width="1100"
        height="415"
        loading="lazy"
      />
      <img
        src="/brand/website-banner.webp"
        alt="The Stacked Couple — Stacking & Tracking. Thriving in Midlife. Coastal sunset with the four stacks: Optimization, Movement, Fuel, Mind."
        width="1600"
        height="671"
        loading="lazy"
      />
    </div>
  </section>

  <!-- THE STACKS — pillar overview -->
  <section class="pillars on-dark">
    <div class="wrap">
      <div class="eyebrow-rule"><span class="label">The Stacks</span></div>
      <p class="stacks-intro">Four stacks. Everything we test, track, and share.</p>
      <div class="grid-4">
        {pillars.map((p) => (
          <a class="pillar-card" href={p.href}>
            <span class="num">{p.num}</span>
            <span class="name">{p.name}</span>
            <span class="blurb">{p.blurb}</span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- GET THE GUIDE — email capture -->
  <section>
    <div class="wrap">
      <EmailCapture />
    </div>
  </section>

  <!-- OUR STACK — affiliate section -->
  <section class="source">
    <div class="wrap">
      <div class="eyebrow-rule"><span class="label">Our Stack</span></div>
      <p class="stack-lede">
        We did our research. Here's our source — use our code for 50% off.
      </p>
      <AffiliateBadge />
    </div>
  </section>

  <!-- FOLLOW THE STACK -->
  <section class="follow on-dark">
    <div class="wrap">
      <div class="eyebrow-rule"><span class="label">Follow the Stack</span></div>
      <p class="follow-intro">We test, track, and share what we learn. Find us here.</p>
      <ul class="follow-list">
        {socials.map((s) => (
          <li>
            <a href={s.url} rel="me noopener" target="_blank">
              <span class="row-label"><span class="platform">{s.label}</span> — <span class="handle">{s.handle}</span></span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero{
    padding:clamp(90px,14vw,160px) 0 clamp(64px,9vw,110px);
    background-image:url('/brand/pattern-dark.webp');
    background-size:420px auto;
  }
  .brand-name{
    font-family:var(--serif);font-size:var(--fs-hero);
    line-height:1.02;letter-spacing:-0.02em;color:var(--cream);
  }
  .tagline{
    font-family:var(--serif);font-size:var(--fs-h3);
    line-height:1.22;letter-spacing:-0.01em;margin-top:24px;
    color:var(--amber);
  }
  .tagline span{display:block}
  .hero-ctas{display:flex;gap:16px;flex-wrap:wrap;margin-top:44px}

  .brand-band{padding-top:0}
  .brand-band img{
    display:block;width:100%;height:auto;
    border:1px solid var(--line);
  }
  .pennant-strip{margin-bottom:clamp(20px,3vw,32px)}

  .whoweare-copy{
    font-family:var(--sans);font-size:var(--fs-body-lg);
    line-height:var(--lh-body);margin-top:clamp(20px,3vw,32px);max-width:var(--measure);
  }
  .whoweare-copy p{margin-bottom:1em}
  .whoweare-copy p:last-child{margin-bottom:0}
  .manifesto-subline{
    font-family:var(--sans);font-size:var(--fs-body-lg);
    color:var(--copper);margin-top:1em;line-height:var(--lh-body);
  }

  .stacks-intro{
    font-family:var(--sans);font-size:var(--fs-body-lg);
    color:var(--stone-light);max-width:44ch;line-height:var(--lh-body);
    margin-top:clamp(14px,2vw,20px);margin-bottom:clamp(32px,5vw,48px);
  }
  .pillar-card{
    display:flex;flex-direction:column;gap:12px;text-decoration:none;
    border:1px solid var(--line-dark);padding:28px 24px;min-height:230px;
    transition:background .2s ease,transform .2s ease;
  }
  .pillar-card:hover{background:rgba(74,127,165,0.12);transform:translateY(-3px)}
  .pillar-card .num{font-family:var(--mono);font-size:var(--fs-caption);font-weight:600;color:var(--copper-light);letter-spacing:0.14em}
  .pillar-card .name{font-family:var(--serif);font-size:var(--fs-h4);color:var(--cream);display:block}
  .pillar-card .blurb{font-family:var(--sans);font-size:var(--fs-body);color:var(--stone-light);flex:1;line-height:var(--lh-body)}
  .pillar-card .go{color:var(--amber);font-size:18px}

  .source{padding-top:0}
  .stack-lede{font-family:var(--sans);font-size:var(--fs-body-lg);max-width:var(--measure);margin-bottom:28px}

  .follow-intro{
    font-family:var(--sans);font-size:var(--fs-body-lg);
    color:var(--stone-light);max-width:44ch;line-height:var(--lh-body);
    margin-top:clamp(14px,2vw,20px);margin-bottom:clamp(24px,4vw,40px);
  }
  .follow-list{list-style:none;border-top:1px solid var(--line-dark)}
  .follow-list a{
    display:flex;align-items:baseline;justify-content:space-between;gap:22px;
    padding:22px 4px;text-decoration:none;
    border-bottom:1px solid var(--line-dark);transition:background .2s ease;
  }
  .follow-list a:hover{background:rgba(74,127,165,0.1)}
  .row-label{color:var(--stone-light)}
  .platform{font-family:var(--serif);font-size:var(--fs-h4);color:var(--cream)}
  .handle{font-family:var(--mono);font-size:var(--fs-caption);color:var(--stone-light)}
  .arrow{color:var(--copper-light);font-size:20px}
</style>
