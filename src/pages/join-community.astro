---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, COMMUNITY } from '../config/site';

/**
 * Join the Community — copy is APPROVED verbatim from the working docs
 * ("Circle Community" tab, between the Approved COPY markers).
 * Do not edit the wording without approval. The join buttons point at the
 * Circle invitation link in src/config/site.ts (COMMUNITY.joinUrl).
 *
 * Deviations from the working docs (Todd, 2026-09-02), pending Jenn's
 * sign-off before the docs are treated as matching the site:
 *   - Hero eyebrow read "The Lab", making an internal nickname the first
 *     thing a first-time visitor saw. Now "The Community"; The Lab is still
 *     named in the free-line below, just not as the opening word.
 *   - Both CTAs read "Join Now"; now "Join for Free", matching the thank-you
 *     page and putting the price in the button itself.
 */

const inside = [
  'The compound reference guide. Plain language. What they are and what they do.',
  'Resources, newsletters and updates. What we are learning, testing, and sharing as we go.',
  'A community of people living midlife on their own terms. Stacking and tracking. Thriving in midlife.',
];
---
<BaseLayout
  title={`Join the Community — ${SITE.name}`}
  description="The Stacked Couple Community is free. This is where the real conversation happens."
>
  <section class="page-hero on-dark">
    <div class="wrap">
      <div class="label">The Community</div>
      <h1>Join The Stacked Couple<br />Community on Circle</h1>
      <p class="free-line">
        The Stacked Couple Community is <strong>FREE</strong> — your membership
        starts in <strong>The Lab</strong>.
      </p>
      <p class="lede">
        This is where the real conversation happens. The stuff we cannot post on
        social — compound names, the basics, vendor recommendations, and the
        foundation you need to start building your own stack.
      </p>
      <a class="btn btn-solid join-cta" href={COMMUNITY.joinUrl}>Join for Free →</a>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Inside The Stacked Couple Community</h2>
      <ul class="inside-list">
        {inside.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <a class="btn btn-solid join-cta" href={COMMUNITY.joinUrl}>Join for Free →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero{padding:clamp(64px,9vw,110px) 0}
  .page-hero h1{margin:16px 0 20px}
  .free-line{
    font-size:var(--fs-body-lg);color:var(--cream);margin-bottom:14px;
  }
  .free-line strong{color:var(--amber)}
  .lede{max-width:var(--measure);font-size:var(--fs-body-lg);color:var(--stone-light)}
  .join-cta{display:inline-block;margin-top:34px}
  h2{margin-bottom:28px;max-width:24ch}
  .inside-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
  .inside-list li{
    padding:22px 0 22px 30px;position:relative;
    border-bottom:1px solid var(--line);
    font-size:var(--fs-body-lg);max-width:var(--measure);
  }
  .inside-list li::before{
    content:"+";position:absolute;left:2px;
    font-family:var(--mono);color:var(--copper);
  }
</style>
