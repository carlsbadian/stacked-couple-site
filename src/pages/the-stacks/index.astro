---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

const stacks = [
  {
    name: 'Optimization',
    href: '/the-stacks/optimization/',
    icon: '/brand/pillar-optimization.webp',
    blurb: "Peptides, supplements, wearables, tracking, and bloodwork. What we've researched and what we're running, so you don't figure it out alone.",
  },
  {
    name: 'Movement',
    href: '/the-stacks/movement/',
    icon: '/brand/pillar-movement.webp',
    blurb: "Strength, conditioning, and recovery. Sustainable and built around real life because we don't have unlimited gym time.",
  },
  {
    name: 'Fuel',
    href: '/the-stacks/fuel/',
    icon: '/brand/pillar-fuel.webp',
    blurb: "Protein targets, meal structure, and what's fueling us in midlife.",
  },
  {
    name: 'Mind',
    href: '/the-stacks/mind/',
    icon: '/brand/pillar-mind.webp',
    blurb: "Sleep, stress, and focus. The part we skipped and the foundation of the whole stack.",
  },
];
---
<BaseLayout
  title={`The Stacks — ${SITE.name}`}
  description="The Stacks is the method: Optimization, Movement, Fuel, Mind."
>
  <section class="page-hero on-dark">
    <div class="wrap">
      <h1>The Stacks</h1>
      <p class="lede">Everything we test, track, and share.</p>
    </div>
  </section>

  <section class="list-sec">
    <div class="wrap">
      <div class="pillar-list">
        {stacks.map((s) => (
          <a class="row" href={s.href}>
            <img class="stack-icon" src={s.icon} alt="" loading="lazy" />
            <span class="name">{s.name}</span>
            <span class="blurb">{s.blurb}</span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero{padding:clamp(64px,9vw,110px) 0}
  .page-hero h1{margin:16px 0 18px;color:var(--amber)}
  .lede{max-width:var(--measure);font-size:var(--fs-body-lg);color:var(--stone-light)}
  .lockup-sec{padding-bottom:0}
  .lockup-grid{
    display:grid;grid-template-columns:minmax(300px,520px) 1fr;
    gap:clamp(32px,5vw,72px);align-items:center;
  }
  @media(max-width:760px){.lockup-grid{grid-template-columns:1fr}}
  .lockup-grid img{display:block;width:100%;height:auto}
  .lockup-copy p{max-width:52ch;margin-bottom:1em;font-size:var(--fs-body)}
  .lockup-copy a{color:var(--copper)}
  .list-sec{padding-top:clamp(40px,6vw,64px)}
  .pillar-list{border-top:1px solid var(--line)}
  .row{
    display:grid;grid-template-columns:70px 240px 1fr 40px;gap:28px;align-items:center;
    padding:34px 4px;border-bottom:1px solid var(--line);text-decoration:none;
    transition:background .2s ease;
  }
  .row:hover{background:rgba(74,127,165,0.08)}
  .stack-icon{width:52px;height:auto;display:block}
  .name{display:block;font-family:var(--serif);font-size:var(--fs-h3);color:var(--navy);line-height:1.05}
  .tag{
    display:block;font-family:var(--mono);font-size:var(--fs-label);letter-spacing:0.16em;
    text-transform:uppercase;color:var(--copper);margin-top:8px;
  }
  .blurb{font-size:var(--fs-body);color:var(--stone-deep)}
  .go{color:var(--copper);font-size:22px}
  @media(max-width:820px){
    .row{grid-template-columns:1fr;gap:10px}
    .go{display:none}
  }
</style>
