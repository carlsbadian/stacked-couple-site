---
/**
 * The Stacks hub. Stack names, outcomes, summaries, colors and icons all come
 * from src/config/stacks.ts — the same source the homepage reads.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import NextStep from '../../components/NextStep.astro';
import { SITE } from '../../config/site';
import { STACKS } from '../../config/stacks';
---
<BaseLayout
  title={`The Stacks — ${SITE.name}`}
  description="Four stacks — Optimization, Mind, Fuel, Movement — and one plan built around you. Start where you'll feel it most."
>
  <section class="page-hero on-dark">
    <div class="wrap">
      <div class="label">The Stacks</div>
      <h1>Four stacks. One plan, built around you.</h1>
      <p class="lede">
        Every plan draws from the same four areas: optimization, mind, fuel, and
        movement. Start where you’ll feel it most.
      </p>
    </div>
  </section>

  <section class="list-sec">
    <div class="wrap">
      <div class="stack-list">
        {STACKS.map((s) => (
          <a class="row" href={s.href}>
            <img class="stack-icon" src={s.icon} alt="" width="64" height="64" loading="lazy" />
            <span class="names">
              <span class="name">{s.name}</span>
              <span class="outcome">{s.outcome}</span>
            </span>
            <span class="summary">{s.summary}</span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <NextStep
    kicker="Not sure where to start?"
    heading="Tell us where you are. We’ll help you pick."
    body="Answer a short assessment, talk it through with us on a 15-minute Stack Session, and get your Phase 1 plan."
  />
</BaseLayout>

<style>
  .page-hero{padding:clamp(64px,9vw,110px) 0}
  .page-hero h1{margin:16px 0 18px;max-width:16em}
  .lede{max-width:var(--measure);font-size:var(--fs-body-lg);color:var(--stone-light)}
  .list-sec{padding-top:clamp(40px,6vw,64px)}
  .stack-list{border-top:1px solid var(--line)}
  .row{
    display:grid;grid-template-columns:72px minmax(220px,320px) 1fr 32px;gap:28px;align-items:center;
    padding:34px 4px;border-bottom:1px solid var(--line);text-decoration:none;
    transition:background .2s ease;
  }
  .row:hover{background:rgba(74,127,165,0.08)}
  .stack-icon{width:60px;height:60px;object-fit:contain;display:block}
  .names{display:flex;flex-direction:column;gap:6px}
  .name{
    font-family:var(--mono);font-size:var(--fs-label);font-weight:var(--fw-semibold);
    letter-spacing:var(--track-label);text-transform:uppercase;color:var(--stone-deep);
  }
  .outcome{font-family:var(--serif);font-size:var(--fs-h3);color:var(--navy);line-height:1.15}
  .summary{font-size:var(--fs-body);color:var(--ink)}
  .go{color:var(--copper);font-size:var(--fs-h4)}
  @media(max-width:820px){
    .row{grid-template-columns:1fr;gap:12px}
    .go{display:none}
  }
</style>
