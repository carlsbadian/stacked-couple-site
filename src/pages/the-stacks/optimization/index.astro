---
/**
 * Optimization stack hub — the four category pages plus the Toolkit.
 * Headline and summary come from src/config/stacks.ts so they match the
 * homepage and /the-stacks/.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NextStep from '../../../components/NextStep.astro';
import { SITE } from '../../../config/site';
import { STACKS } from '../../../config/stacks';

const stack = STACKS.find((s) => s.key === 'optimization')!;

const categories = [
  {
    name: 'Peptide Protocols',
    href: '/the-stacks/optimization/peptide-protocols/',
    blurb: 'What peptides do, how to think about them safely, and what to sort out before you spend a dollar.',
  },
  {
    name: 'Targeted Supplements',
    href: '/the-stacks/optimization/targeted-supplements/',
    blurb: 'Add-ons for a specific goal — and how to tell whether each one is earning its place.',
  },
  {
    name: 'Tracking & Tech',
    href: '/the-stacks/optimization/tracking-tech/',
    blurb: 'The wearables, scales, and apps worth using, and how to read what they tell you.',
  },
  {
    name: 'Biomarker Labs',
    href: '/the-stacks/optimization/biomarker-labs/',
    blurb: 'Which labs to run, how often, and how to read your results in plain language.',
  },
];
---
<BaseLayout
  title={`Optimization — ${SITE.name}`}
  description={stack.summary}
>
  <section class="page-hero on-dark">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/the-stacks/">The Stacks</a></nav>
      <div class="hero-row">
        <div>
          <div class="label">Optimization stack</div>
          <h1>{stack.outcome}</h1>
          <p class="lede">
            {stack.summary} One rule: if it can’t be measured, it doesn’t earn a
            permanent place in your stack.
          </p>
        </div>
        <img
          class="pennant"
          src="/brand/stack-banner-optimization.svg"
          alt=""
          width="360"
          height="480"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cat-grid">
        {categories.map((c) => (
          <a class="cat" href={c.href}>
            <span class="name">{c.name}</span>
            <span class="blurb">{c.blurb}</span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="toolkit-strip">
    <div class="wrap strip">
      <p>Everything we use, in one place — with our discount codes.</p>
      <a class="btn btn-ghost" href="/toolkit/">Open the Toolkit</a>
    </div>
  </section>

  <NextStep />
</BaseLayout>

<style>
  .page-hero{padding:clamp(64px,9vw,110px) 0}
  .crumbs{margin-bottom:22px;font-family:var(--mono);font-size:var(--fs-label);letter-spacing:0.08em}
  .crumbs a{color:var(--stone-light);text-decoration:none;text-transform:uppercase}
  .crumbs a:hover{color:var(--amber)}
  .page-hero h1{margin:16px 0 18px;max-width:16em}
  .lede{max-width:var(--measure);font-size:var(--fs-body-lg);color:var(--stone-light)}
  .hero-row{display:flex;gap:clamp(24px,5vw,64px);align-items:center;justify-content:space-between}
  .pennant{width:clamp(90px,12vw,140px);height:auto;flex-shrink:0}
  @media(max-width:640px){.pennant{display:none}}

  /* four categories: a 2×2 on desktop, one column on a phone — never 3 + 1 */
  .cat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px}
  .cat{
    display:flex;flex-direction:column;gap:12px;background:var(--white);
    border:1px solid var(--rule);border-top:6px solid var(--navy);
    padding:32px 28px;text-decoration:none;min-height:200px;
    transition:background .2s ease,transform .2s ease;
  }
  .cat:hover{background:var(--cream);transform:translateY(-3px)}
  .cat .name{font-family:var(--serif);font-size:var(--fs-h3);color:var(--navy);line-height:1.2}
  .cat .blurb{font-size:var(--fs-body);color:var(--ink);flex:1}
  .cat .go{color:var(--copper);font-size:var(--fs-h4)}
  @media (prefers-reduced-motion: reduce){ .cat:hover{transform:none} }

  .toolkit-strip{padding:44px 0;border-top:1px solid var(--rule)}
  .strip{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px 40px}
  .strip p{
    flex:1 1 420px;margin:0;max-width:none;
    font-family:var(--serif);font-size:var(--fs-h3);line-height:1.3;color:var(--navy);
  }
</style>
