---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolkitCard from '../components/ToolkitCard.astro';
import { TOOLKIT, TOOLKIT_META } from '../config/toolkit';
import { SITE } from '../config/site';
---
<BaseLayout
  title={`${TOOLKIT_META.title} — ${SITE.name}`}
  description={TOOLKIT_META.subtitle}
>
  <section class="page-hero on-dark">
    <div class="wrap">
      <div class="label">The Toolkit</div>
      <h1>{TOOLKIT_META.title}</h1>
      <p class="lede">{TOOLKIT_META.subtitle}</p>
    </div>
  </section>

  <section class="disclosure-sec">
    <div class="wrap">
      <p class="disclosure">{TOOLKIT_META.disclosure}</p>
    </div>
  </section>

  {TOOLKIT.map((cat) => (
    <section class="cat-sec">
      <div class="wrap">
        <div class="eyebrow-rule"><span class="label">{cat.name}</span></div>
        <div class="card-grid">
          {cat.items.map((item) => (
            <ToolkitCard item={item} />
          ))}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .page-hero{padding:clamp(64px,9vw,110px) 0}
  .page-hero h1{margin:16px 0 18px}
  .lede{max-width:var(--measure);font-size:var(--fs-body-lg);color:var(--stone-light)}
  .disclosure-sec{padding:clamp(28px,4vw,40px) 0 0}
  .disclosure{
    font-size:var(--fs-legal);color:var(--stone-deep);
    border-left:3px solid var(--amber);padding:10px 0 10px 16px;
    max-width:var(--measure);margin:0;
  }
  .cat-sec{padding:clamp(36px,5vw,56px) 0 0}
  .cat-sec:last-of-type{padding-bottom:clamp(64px,9vw,96px)}
  .card-grid{
    display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
    gap:24px;margin-top:8px;
  }
</style>
