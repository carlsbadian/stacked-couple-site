---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolkitCard from '../components/ToolkitCard.astro';
import NextStep from '../components/NextStep.astro';
import { TOOLKIT, TOOLKIT_META } from '../config/toolkit';
import { SITE } from '../config/site';
---
<BaseLayout
  title={`${TOOLKIT_META.title} — ${SITE.name}`}
  description={TOOLKIT_META.subtitle}
>
  <section class="page-hero on-dark">
    <div class="wrap">
      <div class="label">{TOOLKIT_META.title}</div>
      <h1>{TOOLKIT_META.headline}</h1>
      <p class="lede">{TOOLKIT_META.subtitle}</p>
    </div>
  </section>

  <section class="disclosure-sec">
    <div class="wrap">
      <p class="disclosure">{TOOLKIT_META.disclosure}</p>
    </div>
  </section>

  {TOOLKIT.map((cat, i) => (
    <section class:list={['cat-sec', { last: i === TOOLKIT.length - 1 }]}>
      <div class="wrap">
        <div class="eyebrow-rule"><span class="label">{cat.name}</span></div>
        <div class="card-grid">
          {cat.items.map((item) => (
            <ToolkitCard item={item} />
          ))}
        </div>
      </div>
    </section>
  ))}

  <NextStep
    heading="Not sure what belongs in your stack?"
    body="The Toolkit shows what we use — not what you need. Tell us your goals and history, and we’ll help you build a stack that fits you."
  />
</BaseLayout>

<style>
  .page-hero{padding:clamp(64px,9vw,110px) 0}
  .page-hero h1{margin:16px 0 18px;max-width:16em}
  .lede{max-width:var(--measure);font-size:var(--fs-body-lg);color:var(--stone-light)}
  .disclosure-sec{padding:clamp(28px,4vw,40px) 0 0}
  .disclosure{
    font-size:var(--fs-legal);color:var(--stone-deep);
    background:var(--white);border:1px solid var(--rule);border-radius:4px;
    padding:14px 18px;max-width:var(--measure);margin:0;
  }
  .cat-sec{padding:clamp(36px,5vw,56px) 0 0}
  .cat-sec.last{padding-bottom:clamp(64px,9vw,96px)}
  .card-grid{
    display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
    gap:24px;margin-top:8px;
  }
</style>
