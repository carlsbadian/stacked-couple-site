---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConfirmationCards from '../../components/ConfirmationCards.astro';
import { SITE } from '../../config/site';

/**
 * Post-submission confirmation for the Stack Assessment. The Tally form
 * (jaraL9) redirects here on completion (set in Tally: Settings → Redirect on
 * completion → https://www.thestackedcouple.com/build-your-stack/thanks).
 *
 * Hidden page: noindex, not in nav. Renamed from /thank-you/ (301 in
 * public/_redirects) — leave that redirect in place until the Tally redirect
 * has been repointed.
 *
 * guide="download" because submitting the assessment also triggers a
 * confirmation email carrying the same PDF.
 */
---
<BaseLayout
  title={`Got it. — ${SITE.name}`}
  description="We read your Stack Assessment and send you a link to book your Stack Session. After the call, we deliver Your Stack Plan."
  noindex
>
  <section class="page-hero on-dark">
    <div class="wrap">
      <h1>Got it.</h1>
      <p class="lede">
        We read your Stack Assessment personally, then send you a link to book your
        Stack Session — 15 to 20 minutes, within 24 to 48 hours. After the call, we
        deliver Your Stack Plan, built from your answers.
      </p>
    </div>
  </section>

  <ConfirmationCards guide="download" />
</BaseLayout>

<style>
  .page-hero{padding:clamp(64px,9vw,110px) 0}
  .page-hero h1{margin:16px 0 18px}
  .lede{max-width:var(--measure);font-size:var(--fs-body-lg);color:var(--stone-light)}
</style>
