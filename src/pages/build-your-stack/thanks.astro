---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, COMMUNITY } from '../../config/site';

/**
 * Post-submission confirmation for the Stack Assessment. The Tally form
 * (jaraL9) redirects here on completion (set in Tally: Settings → Redirect on
 * completion → https://www.thestackedcouple.com/build-your-stack/thanks).
 *
 * Hidden page: noindex, not in nav. Renamed from /thank-you/ (301 in
 * public/_redirects) — leave that redirect in place until the Tally redirect
 * has been repointed.
 */
---
<BaseLayout
  title={`Got it. — ${SITE.name}`}
  description="We will read your Stack Assessment and send you a link to book your Stack Session within two days."
  noindex
>
  <section class="page-hero on-dark">
    <div class="wrap">
      <h1>Got it.</h1>
      <p class="lede">
        We will read your Stack Assessment and send you a link to book your Stack
        Session within two days. It is 15–20 minutes, and we work from your
        answers — so the more specific you were, the better the call.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="secondary">In the meantime, two things worth doing:</p>
      <ul class="two-things">
        <li><a href={COMMUNITY.joinUrl}>Join The Lab, our free community on Circle</a></li>
        <li><a href="/get-the-guide/">Get the Guide</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero{padding:clamp(64px,9vw,110px) 0}
  .page-hero h1{margin:16px 0 18px}
  .lede{max-width:var(--measure);font-size:var(--fs-body-lg);color:var(--stone-light)}
  .secondary{max-width:var(--measure);margin:0 0 12px}
  .two-things{list-style:none;margin:0;padding:0;max-width:var(--measure)}
  .two-things li{padding:14px 0;border-bottom:1px solid var(--line)}
  .two-things a{color:var(--copper)}
</style>
