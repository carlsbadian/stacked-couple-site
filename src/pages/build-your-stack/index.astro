---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';

/**
 * Build Your Stack. The Stack Assessment itself is a Tally embed (form id
 * jaraL9), which owns the full question set — manage questions/copy in Tally,
 * not here. The embed script is is:inline so Astro leaves it untouched.
 *
 * Hidden page: noindex, deliberately not in NAV. Linked from email and the
 * /links hub only. Renamed 2026-09-07; the former slug 301s here via
 * public/_redirects.
 */

/** Used for the meta/OG description and the sub-line under the H1. */
const SUMMARY =
  'Tell us where you are starting. We read every answer, then get on a 15-minute Stack Session with you and build your Phase 1 Stack Plan.';
---
<BaseLayout
  title={`Build Your Stack | ${SITE.name}`}
  description={SUMMARY}
  noindex
>
  <section class="page-hero on-dark">
    <div class="wrap">
      <div class="label">Stack Assessment</div>
      <h1>Build Your Stack</h1>
      <p class="lede">{SUMMARY}</p>
    </div>
  </section>

  <section>
    <div class="form-container">
      <iframe
        data-tally-src="https://tally.so/embed/jaraL9?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
        loading="lazy"
        width="100%"
        height="674"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title="Stack Assessment"
      ></iframe>
      <noscript>
        <p class="fallback">
          The Stack Assessment needs JavaScript. You can also open it directly:
          <a href="https://tally.so/r/jaraL9">tally.so/r/jaraL9</a>
        </p>
      </noscript>
      <p class="form-legal">
        All information shared here is confidential and used solely to assess fit.
        For educational purposes only — not medical advice.
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}</script>

<style>
  .page-hero{padding:clamp(64px,9vw,110px) 0}
  .page-hero h1{margin:16px 0 18px}
  .lede{max-width:var(--measure);font-size:var(--fs-body-lg);color:var(--stone-light)}
  /* centered embed container — max-w-4xl mx-auto py-12 px-4 equivalent */
  .form-container{
    max-width:896px;
    margin-inline:auto;
    padding:48px 16px;
  }
  .fallback{color:var(--text-muted)}
  .fallback a{color:var(--accent)}
  .form-legal{
    max-width:var(--measure);
    margin-top:24px;
    font-size:var(--fs-caption);
    color:var(--text-muted);
  }
</style>
