---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import NextStep from '../../components/NextStep.astro';
import { getCollection } from 'astro:content';
import { SITE, SOCIAL } from '../../config/site';

const posts = (await getCollection('experiment', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pillarLabel: Record<string, string> = {
  movement: 'Movement',
  fuel: 'Fuel',
  optimization: 'Optimization',
  mind: 'Mind',
};

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const gets = [
  { title: 'Protocol updates, with the data', body: 'What we started, what changed, and what the numbers showed.' },
  { title: 'The honest results', body: 'What worked, what didn’t, and what we’d do differently.' },
  { title: 'First word on what’s next', body: 'New guides, plans, and ways to work with us — before they’re public.' },
];

/**
 * TODO(Todd): when the Substack publication is live, add its RSS feed here
 * (fetch + parse at build time) and interleave those entries into this feed
 * with an "On Substack →" external marker. Config lives in src/config/site.ts.
 */
---
<BaseLayout
  title={`The Experiment — ${SITE.name}`}
  description="What we're testing, what the numbers say, and what we'd do differently — in your inbox first."
>
  <section class="page-hero on-dark">
    <div class="wrap">
      <div class="label">The Experiment</div>
      <h1>Follow the experiment.</h1>
      <p class="lede">
        What we’re testing, what the numbers say, and what we’d do differently — in
        your inbox before it’s anywhere else.
      </p>
    </div>
  </section>

  <section class="newsletter-sec">
    <div class="wrap nl-grid">
      <div class="nl-copy">
        <p class="kicker">What you’ll get</p>
        <ul class="gets">
          {gets.map((g) => (
            <li>
              <span class="g-title">{g.title}</span>
              <span class="g-body">{g.body}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="nl-constrain">
        <NewsletterSignup />
      </div>
    </div>
  </section>

  <NextStep
    heading="Want more than updates?"
    body="Tell us your goals and history, and we’ll help you build a stack that fits you — starting with a 15-minute Stack Session."
  />
</BaseLayout>

<style>
  .page-hero{padding:clamp(64px,9vw,110px) 0}
  .page-hero h1{margin:16px 0 18px}
  .lede{max-width:var(--measure);font-size:var(--fs-body-lg);color:var(--stone-light)}
  .slogan-line{
    margin-top:36px;padding:14px 0 14px 22px;border-left:3px solid var(--copper);
    font-family:var(--mono);font-size:clamp(14px,2vw,18px);letter-spacing:0.14em;
    text-transform:uppercase;color:var(--cream);
  }
  .slogan-line .hl{color:var(--amber)}
  .feed{list-style:none;border-top:1px solid var(--line)}
  .entry{
    display:block;padding:30px 4px;border-bottom:1px solid var(--line);
    text-decoration:none;transition:background .2s ease;
  }
  .entry:hover{background:rgba(74,127,165,0.07)}
  .meta{display:flex;gap:18px;align-items:baseline;margin-bottom:10px}
  .pillar{
    font-family:var(--mono);font-size:var(--fs-label);letter-spacing:0.16em;
    text-transform:uppercase;color:var(--copper);
  }
  time{font-family:var(--mono);font-size:var(--fs-legal);color:var(--stone-deep)}
  .title{display:block;font-family:var(--serif);font-size:var(--fs-h3);color:var(--navy);margin-bottom:8px}
  .desc{display:block;font-size:var(--fs-body);color:var(--stone-deep);max-width:var(--measure)}
  .empty{padding:40px 0}
  .empty a{color:var(--copper)}
  .nl-grid{display:flex;flex-wrap:wrap;gap:40px 64px;align-items:flex-start}
  .nl-copy{flex:1 1 360px;min-width:0}
  .nl-constrain{flex:1 1 440px;min-width:0;max-width:640px}
  .gets{list-style:none;margin:0;padding:0}
  .gets li{
    display:flex;flex-direction:column;gap:4px;max-width:none;
    padding:18px 0;border-top:1px solid var(--rule);
  }
  .g-title{font-family:var(--serif);font-size:var(--fs-h4);color:var(--navy)}
  .g-body{color:var(--text-muted)}
</style>
