---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

/**
 * Intake application — the form itself is a Tally embed (form id jaraL9),
 * which now owns the full question set. Manage questions/copy in Tally,
 * not here. The embed script is is:inline so Astro leaves it untouched.
 */
---
<BaseLayout
  title={`Work With Us — ${SITE.name}`}
  description="Apply to work with us directly. Honest answers, better fit."
  noindex
>
  <section class="page-hero on-dark">
    <div class="wrap">
      <div class="label">Work With Us</div>
      <h1>Application to work with us</h1>
      <p class="lede">
        Take a few minutes to fill this out honestly. The more complete your answers,
        the better we can assess whether we're the right fit and what working together
        would actually look like.
      </p>
    </div>
  </section>

  <section>
    <div class="form-container">
      <iframe
        data-tally-src="https://tally.so/embed/jaraL9?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
        loading="lazy"
        width="100%"
        height="674"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title="Application to work with us"
      ></iframe>
      <noscript>
        <p class="fallback">
          The application form needs JavaScript. You can also open it directly:
          <a href="https://tally.so/r/jaraL9">tally.so/r/jaraL9</a>
        </p>
      </noscript>
    </div>
  </section>
</BaseLayout>

<script is:inline>var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}</script>

<style>
  .page-hero{padding:clamp(64px,9vw,110px) 0}
  .page-hero h1{margin:16px 0 18px}
  .lede{max-width:var(--measure);font-size:var(--fs-body-lg);color:var(--stone-light)}
  /* centered embed container — max-w-4xl mx-auto py-12 px-4 equivalent */
  .form-container{
    max-width:896px;
    margin-inline:auto;
    padding:48px 16px;
  }
  .fallback{color:var(--text-muted)}
  .fallback a{color:var(--accent)}
</style>
