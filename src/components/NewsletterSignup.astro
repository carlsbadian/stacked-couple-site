---
/**
 * Newsletter sign-up — Tally form 9qYqAG (name + email side by side).
 * Replaces the previous Circle embed.
 *
 * Tally renders its field text in dark charcoal, so the form sits on a
 * light panel: readable on the navy footer AND consistent on the cream
 * Experiment page. Button styling (copper) is set in Tally itself.
 *
 * Pass `onDark` on a navy ground so the disclaimer uses the navy-safe tint.
 */
interface Props {
  onDark?: boolean;
}
const { onDark = false } = Astro.props;
---
<div class:list={['newsletter', { 'is-dark': onDark }]}>
  <div class="label">Newsletter</div>
  <div class="panel">
    <iframe
      data-tally-src="https://tally.so/embed/9qYqAG?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
      loading="lazy"
      width="100%"
      height="177"
      frameborder="0"
      marginheight="0"
      marginwidth="0"
      title="Newsletter"
    ></iframe>
  </div>
  <p class="fine">
    By subscribing you agree to receive future emails from The Stacked Couple.
    We don’t spam. Unsubscribe anytime.
  </p>
</div>

<script is:inline>var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}</script>

<style>
  .newsletter .label{margin-bottom:12px}
  .panel{
    background:var(--cream);
    border:1px solid var(--rule);
    /* tight padding — the form is horizontal now, so it needs width, not height */
    padding:clamp(10px,1.6vw,18px) clamp(12px,2vw,22px);
  }
  .panel iframe{display:block;width:100%;border:0}
  .fine{font-size:var(--fs-legal);color:var(--stone-deep);margin-top:10px}
  .is-dark .fine{color:var(--stone-light)}
</style>
