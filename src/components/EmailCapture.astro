---
/**
 * Gated lead-magnet email capture — "Get the Guide".
 * The value proposition is execution and convenience: the printable
 * dosage tracker, reconstitution cheat sheet, and startup checklist.
 *
 * The form itself is a Circle form embed (uid fc9c8b46, the-stacked-couple
 * .circle.so). Circle renders the field + button into the placeholder div
 * and owns the submit, the success state, and the email that delivers the
 * guide — none of that is configurable from this repo. Button label, success
 * message and the delivery email are edited in Circle, not here.
 *
 * The loader must stay `is:inline` so Astro leaves it alone instead of
 * bundling it as a module.
 */
interface Props {
  heading?: string;
  compact?: boolean;
}
const {
  heading = 'The Peptide Guide We Wish We’d Had.',
  compact = false,
} = Astro.props;
---
<div class:list={['capture', 'on-dark', { compact }]}>
  <div class="label">Get the Guide</div>
  <h3>{heading}</h3>
  {!compact && (
    <p class="pitch">
      A reference guide to the compounds. What they are, what they do, and why your
      stack will look nothing like ours. Yours when you join the list.
    </p>
  )}
  <div class="form-slot">
    <div data-is-popup="false" data-circle-form-uid="fc9c8b46"></div>
    <noscript>
      <p class="fallback">
        The signup form needs JavaScript. You can also join the community and pick
        up the guide there: <a href="https://the-stacked-couple.circle.so/">the-stacked-couple.circle.so</a>
      </p>
    </noscript>
  </div>
  <p class="fine">
    For research purposes only. Not medical advice. We don’t spam. Unsubscribe anytime.
  </p>
</div>

<script is:inline>if(!window.circleFormsScriptLoaded){window.circleFormsScriptLoaded=true;const script=document.createElement('script');script.src='https://the-stacked-couple.circle.so/external/form-embeds.js';script.defer=true;document.head.appendChild(script)}</script>

<style>
  .capture{
    background:var(--navy);color:var(--cream);
    padding:clamp(32px,5vw,56px);border:1px solid var(--line-dark);
  }
  .capture .label{color:var(--amber);margin-bottom:14px}
  h3{margin-bottom:14px}
  .pitch{font-size:var(--fs-body-lg);color:var(--stone-light);max-width:var(--measure);margin-bottom:26px}
  .compact .pitch{display:none}
  /* Circle renders its form on white with dark type, so the embed gets a white
     slot rather than the navy ground of .capture — matching the iframe's own
     background keeps the seam invisible. */
  .form-slot{
    background:var(--white);margin-bottom:16px;
  }
  /* Circle sizes the iframe itself and gets it wrong on first paint (312px
     against ~400px of content), which clips the submit button behind an
     internal scrollbar. The floor keeps the whole form reachable; Circle can
     still grow past it. */
  .form-slot :global(iframe){display:block;width:100%;border:0;min-height:430px}
  .fine{font-size:var(--fs-legal);color:var(--stone-light)}
  .fallback{font-size:var(--fs-body);color:var(--ink)}
  .fallback a{color:var(--copper)}
</style>
