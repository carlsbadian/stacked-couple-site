---
/**
 * The "Get the Guide" signup form — just the form panel and its fine print.
 * Each page writes its own heading and pitch around it (2026-11 refresh), so
 * the guide can be pitched in context instead of in one fixed box.
 *
 * The form is a Tally embed (1AaLG4). Tally owns the submit, the success
 * state, and the email that delivers the guide — button label, success
 * message and delivery are edited in Tally, not here.
 *
 * Tally renders its field text in dark charcoal, so the form always sits on
 * a light panel, even on a navy section. Pass `onDark` on a navy ground so
 * the fine print switches to the navy-safe tint. The loader must stay
 * `is:inline` so Astro leaves it alone instead of bundling it as a module.
 */
interface Props {
  onDark?: boolean;
}
const { onDark = false } = Astro.props;
---
<div class:list={['email-capture', { 'is-dark': onDark }]}>
  <div class="panel">
    <iframe
      data-tally-src="https://tally.so/embed/1AaLG4?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
      loading="lazy"
      width="100%"
      height="177"
      frameborder="0"
      marginheight="0"
      marginwidth="0"
      title="Get the free guide"
    ></iframe>
    <noscript>
      <p class="fallback">
        The signup form needs JavaScript. You can also open it directly:
        <a href="https://tally.so/r/1AaLG4">tally.so/r/1AaLG4</a>
      </p>
    </noscript>
  </div>
  <p class="fine">
    Free. Unsubscribe anytime. For educational purposes only — not medical advice.
  </p>
</div>

<script is:inline>var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}</script>

<style>
  .panel{
    background:var(--cream);border:1px solid var(--rule);
    padding:clamp(10px,1.6vw,18px) clamp(12px,2vw,22px);
  }
  .panel iframe{display:block;width:100%;border:0}
  .fine{font-size:var(--fs-legal);color:var(--stone-deep);margin:12px 0 0}
  .is-dark .fine{color:var(--stone-light)}
  .fallback{font-size:var(--fs-body);color:var(--ink)}
  .fallback a{color:var(--copper)}
</style>
