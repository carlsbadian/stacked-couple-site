---
/**
 * One Toolkit directory card. Active items render a live outbound CTA
 * (rel includes `sponsored` for affiliate compliance); placeholders and
 * active items with no URL yet render a disabled-state button.
 */
import type { ToolkitItem } from '../config/toolkit';

interface Props {
  item: ToolkitItem;
}
const { item } = Astro.props;
const live = !item.isPlaceholder && (!!item.url || !!item.stores);
---
<article class:list={['card', { placeholder: item.isPlaceholder }]}>
  <div class="badges">
    {item.badges.map((b) => (
      <span class:list={['chip', { offer: /off|code/i.test(b) }]}>{b}</span>
    ))}
  </div>
  {item.logo && (
    <img
      class="partner-logo"
      src={item.logo.src}
      alt={item.logo.alt}
      width={item.logo.width}
      height={item.logo.height}
      loading="lazy"
    />
  )}
  <h3>{item.title}</h3>
  <p class="desc">{item.description}</p>
  {item.promo && <p class="promo">{item.promo}</p>}
  {live && item.stores ? (
    <div class="store-badges">
      <a href={item.stores.appStore} target="_blank" rel="noopener noreferrer sponsored">
        <img src="/brand/partners/badge-app-store.svg" alt="Download on the App Store" width="120" height="40" loading="lazy" />
      </a>
      <a href={item.stores.googlePlay} target="_blank" rel="noopener noreferrer sponsored">
        <img src="/brand/partners/badge-google-play.png" alt="Get it on Google Play" width="135" height="40" loading="lazy" />
      </a>
    </div>
  ) : live ? (
    <a class="btn btn-solid cta" href={item.url} target="_blank" rel="noopener noreferrer sponsored">
      {item.cta}
    </a>
  ) : (
    <span class="btn cta cta-disabled" aria-disabled="true">{item.cta}</span>
  )}
</article>

<style>
  .card{
    display:flex;flex-direction:column;gap:14px;
    border:1px solid var(--line);background:var(--white);
    padding:clamp(22px,3vw,30px);
  }
  .card.placeholder{background:transparent;border-style:dashed}
  .badges{display:flex;gap:10px;flex-wrap:wrap}
  .chip{
    font-family:var(--mono);font-size:var(--fs-label);letter-spacing:0.06em;
    text-transform:uppercase;padding:4px 10px;
    border:1px solid var(--line);color:var(--stone-deep);
  }
  .chip.offer{border-color:var(--copper);color:var(--copper)}
  h3{margin:0}
  .desc{color:var(--text-muted);flex:1;margin:0}
  .promo{
    font-family:var(--mono);font-size:var(--fs-label);
    color:var(--copper);border-left:3px solid var(--amber);
    padding-left:12px;margin:0;
  }
  .cta{align-self:flex-start}
  .cta-disabled{
    border:1px solid var(--line);color:var(--stone-deep);
    background:transparent;cursor:not-allowed;
  }
  .partner-logo{
    display:block;width:min(180px,60%);height:auto;
    /* white wordmark file variant is for dark grounds; this is the black one */
  }
  .store-badges{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
  .store-badges img{display:block;height:44px;width:auto}
</style>
