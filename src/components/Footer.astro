---
import { SITE, SOCIAL, LEGAL_FOOTER } from '../config/site';
import NewsletterSignup from './NewsletterSignup.astro';
const socials = [SOCIAL.youtube, SOCIAL.instagram, SOCIAL.tiktok, SOCIAL.substack].filter(
  (s) => s.url,
);
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="stacks-band">
      <p class="band-label"><span class="amber">Four Stacks.</span> One Foundation.</p>
      <div class="band-pennants" aria-label="Optimization Stack, Mind Stack, Fuel Stack, Movement Stack" role="img">
        <img src="/brand/stack-banner-optimization.svg" alt="" width="360" height="480" loading="lazy" />
        <img src="/brand/stack-banner-mind.svg" alt="" width="360" height="480" loading="lazy" />
        <img src="/brand/stack-banner-fuel.svg" alt="" width="360" height="480" loading="lazy" />
        <img src="/brand/stack-banner-movement.svg" alt="" width="360" height="480" loading="lazy" />
      </div>
    </div>
    <div class="newsletter-slot">
      <NewsletterSignup onDark />
    </div>
    <div class="top">
      <div>
        <div class="mark">{SITE.name}</div>
        <p class="tagline">{SITE.tagline}</p>
      </div>
      <ul class="socials" aria-label="Follow us">
        {socials.map((s) => (
          <li>
            <a href={s.url} rel="me noopener" target="_blank">
              {s.label} <span class="handle">{s.handle}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <p class="legal">{LEGAL_FOOTER}</p>
    <p class="copy">© {year} {SITE.name} · {SITE.location}</p>
  </div>
</footer>

<style>
  .site-footer{padding:64px 0 40px;border-top:1px solid var(--line-dark)}
  .stacks-band{
    display:flex;align-items:center;justify-content:space-between;gap:28px;
    flex-wrap:wrap;border:1px solid var(--line-dark);
    padding:clamp(18px,3vw,28px) clamp(20px,3.5vw,36px);
    margin-bottom:52px;
  }
  .band-label{
    font-family:var(--mono);font-size:var(--fs-label);
    letter-spacing:var(--track-label);text-transform:uppercase;
    color:var(--cream);margin:0;
  }
  .band-label .amber{color:var(--amber)}
  .band-pennants{display:flex;gap:clamp(14px,2.5vw,26px)}
  .band-pennants img{display:block;width:clamp(44px,6vw,64px);height:auto}
  .newsletter-slot{max-width:720px;margin-bottom:52px}
  .top{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;margin-bottom:44px}
  .mark{font-family:var(--wordmark);font-size:24px;margin-bottom:8px}
  .tagline{font-family:var(--sans);font-size:var(--fs-caption);color:var(--amber)}
  .socials{list-style:none}
  .socials a{
    display:block;padding:6px 0;text-decoration:none;
    font-family:var(--mono);font-size:var(--fs-label);letter-spacing:0.08em;color:var(--cream);
  }
  .socials a:hover .handle{color:var(--amber)}
  .handle{color:var(--stone-light);margin-left:10px}
  .legal{
    max-width:var(--measure);font-size:var(--fs-legal);color:var(--stone-light);
    border-top:1px solid var(--line-dark);padding-top:28px;margin-bottom:16px;
  }
  .copy{font-family:var(--mono);font-size:var(--fs-legal);color:var(--stone-light)}
</style>
